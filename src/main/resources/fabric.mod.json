{
	"schemaVersion": 1,
	"id": "light-overlay",
	"version": "${version}",
	"name": "Light Overlay",
	"description": "A Light Overlay Mod that's efficient and simple.",
	"authors": [
		"Lugo_Sieben"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/lightoverlay",
		"issues": "https://github.com/lugosieben/lightoverlay/issues/new",
        "sources": "https://github.com/lugosieben/lightoverlay"
	},
	"license": "CC BY-NC-SA 4.0",
	"icon": "assets/light-overlay/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"net.lugo.lightoverlay.LightOverlay"
		],
        "modmenu": [
          "net.lugo.lightoverlay.config.ModMenuIntegration"
        ]
	},
	"mixins": [
      "light-overlay.mixins.json"
	],
	"depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": "${minecraft_version_compatible}",
        "java": ">=${java_version}",
        "fabric-api": ">=${fabric_version}",
        "overlaylib": "~${overlaylib_version}",
        "yet_another_config_lib_v3": ">=${yacl_version}"
	},
	"suggests": {
		"modmenu": ">=${modmenu_version}"
	},
	"custom": {
		"mc-publish": {
			"dependencies": [
				"fabric-api@>=${fabric_version}(required){modrinth:P7dR8mSH}{curseforge:306612}",
				"overlaylib@~${overlaylib_version}(required){modrinth:M1B8mLoH}{curseforge:1447526}",
				"yet_another_config_lib_v3@>=${yacl_version}(required){modrinth:1eAoo2KR}{curseforge:667299}",
				"modmenu@>=${modmenu_version}(optional){modrinth:mOgUt4GM}{curseforge:308702}"
			]
		}
	}
}